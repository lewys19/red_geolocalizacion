# Copia este archivo como .env (junto a docker-compose.yml) y completa los valores.

# Obligatorio. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Contraseña de PostgreSQL. Obligatoria; genera una igual que la anterior.
DB_PASSWORD=

# Puertos en este equipo (los de la base y Redis solo escuchan en 127.0.0.1).
PUERTO_WEB=3100
PUERTO_API=8100
PUERTO_DB=5433
PUERTO_REDIS=6380

# Orígenes que pueden llamar a la API directamente, separados por coma.
CORS_ORIGINS=http://localhost:3100

# Contacto que se envía a Nominatim (OpenStreetMap) al sugerir direcciones; lo exige su política de uso.
GEOCODING_CONTACTO=

# Dirección pública de la web, sin / al final (en el servidor: https://tu-dominio).
URL_PUBLICA=http://localhost:3100

# Ingreso con Google y con Hotmail/Outlook. Vacíos = botones desactivados ("pronto").
# Se crean en console.cloud.google.com y en entra.microsoft.com (registro de aplicaciones),
# con esta URL de vuelta:  {URL_PUBLICA}/api/v1/auth/externo/google/vuelta  (o .../microsoft/vuelta)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Procesos de la API. 1 en tu equipo; en el servidor, 2 a 4 según los núcleos.
UVICORN_WORKERS=1

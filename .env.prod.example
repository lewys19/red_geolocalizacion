# .env de Altoque en el servidor. Cópialo como ~/altoque/.env en el VPS, complétalo y protégelo:
#   chmod 600 .env
# Nunca se sube a GitHub.

# Obligatorios. Genera cada uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DB_PASSWORD=

# Dirección pública, sin / al final. Debe coincidir con el dominio del proxy (despliegue/proxy/Caddyfile).
URL_PUBLICA=https://altoque.zcorp23.com

# Contacto que se envía a Nominatim (OpenStreetMap); lo exige su política de uso. Un correo del proyecto.
GEOCODING_CONTACTO=

# Procesos de la API: 2 a 4 según los núcleos del VPS.
UVICORN_WORKERS=2

# Versión a usar: latest o el hash de un commit de main (para volver atrás).
VERSION=latest

# Ingreso con Google y Hotmail/Outlook. Vacíos = botones "(pronto)".
# URL de vuelta: {URL_PUBLICA}/api/v1/auth/externo/google/vuelta  (o .../microsoft/vuelta)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
